---
import type { ExperienceEntry } from '../data/experience';

interface Props {
  entries: ExperienceEntry[];
}

const { entries } = Astro.props;
---

<div class="relative space-y-6 border-l border-slate-200 pl-6 dark:border-slate-800">
  {entries.map((entry, i) => (
    <details class="reveal group relative" open={i === 0}>
      <span class="absolute -left-[29px] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-brand-500 dark:border-slate-950"></span>
      <summary class="card cursor-pointer list-none px-5 py-4 transition-shadow hover:shadow-md">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <div>
            <p class="font-semibold">{entry.role}</p>
            <p class="text-sm text-brand-500">{entry.company}</p>
          </div>
          <span class="text-xs font-medium text-slate-500 dark:text-slate-400">{entry.start} — {entry.end}</span>
        </div>
      </summary>
      <div class="mt-3 space-y-3 px-5 pb-2">
        <ul class="list-disc space-y-1.5 pl-5 text-sm text-slate-600 dark:text-slate-300">
          {entry.bullets.map((bullet) => <li>{bullet}</li>)}
        </ul>
        <div class="flex flex-wrap gap-2 pt-1">
          {entry.tools.map((tool) => (
            <span class="rounded-full bg-brand-50 px-2.5 py-1 text-xs font-medium text-brand-700 dark:bg-brand-900/40 dark:text-brand-200">
              {tool}
            </span>
          ))}
        </div>
      </div>
    </details>
  ))}
</div>
