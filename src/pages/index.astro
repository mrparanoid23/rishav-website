---
import BaseLayout from '../layouts/BaseLayout.astro';
import StatCounter from '../components/StatCounter.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { bio } from '../data/bio';
import { pillars, principles } from '../data/homepage';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title={site.name} description={site.description} path="/" includePersonSchema>
  <section class="container-page flex flex-col items-start gap-6 pb-16 pt-20 sm:pt-28">
    <p class="reveal is-visible font-mono text-sm uppercase tracking-wide text-brand-500">
      {site.tagline}
    </p>
    <h1 class="reveal is-visible max-w-3xl text-4xl font-bold leading-tight tracking-tight sm:text-6xl">
      Stop guessing. <span class="gradient-text">Start growing with data.</span>
    </h1>
    <p class="reveal is-visible max-w-2xl text-lg leading-relaxed text-slate-600 dark:text-slate-300">
      {bio.summary}
    </p>
    <div class="reveal is-visible flex flex-wrap gap-4 pt-2">
      <a href="/videos" class="rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 hover:bg-brand-600">
        Watch my videos
      </a>
      <a href="/projects" class="rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold transition-transform hover:-translate-y-0.5 hover:border-brand-400 dark:border-slate-700">
        View my work
      </a>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-slate-50/60 py-14 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="container-page grid grid-cols-2 gap-8 sm:grid-cols-4">
      {bio.stats.map((stat) => (
        <StatCounter value={stat.value} suffix={stat.suffix} label={stat.label} />
      ))}
    </div>
  </section>

  <section class="border-t border-slate-200 py-20 dark:border-slate-800">
    <div class="container-page">
      <div class="reveal mb-10">
        <p class="font-mono text-sm text-brand-500">What I Do</p>
        <h2 class="text-3xl font-bold tracking-tight">Three ways I help businesses grow.</h2>
      </div>
      <div class="grid gap-6 sm:grid-cols-3">
        {pillars.map((pillar) => (
          <article class="reveal card p-6">
            <h3 class="text-lg font-semibold">{pillar.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{pillar.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-page py-20">
    <div class="reveal mb-10 flex items-end justify-between">
      <div>
        <p class="font-mono text-sm text-brand-500">Selected Work</p>
        <h2 class="text-3xl font-bold tracking-tight">Featured Projects</h2>
      </div>
      <a href="/projects" class="hidden text-sm font-semibold text-brand-500 hover:underline sm:block">View all →</a>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((project) => (
        <ProjectCard
          slug={project.id}
          title={project.data.title}
          summary={project.data.summary}
          tags={project.data.tags}
          status={project.data.status}
        />
      ))}
    </div>
  </section>

  <section class="border-t border-slate-200 py-20 dark:border-slate-800">
    <div class="container-page">
      <div class="reveal mb-12">
        <p class="font-mono text-sm text-brand-500">How I Think</p>
        <h2 class="text-3xl font-bold tracking-tight">Three questions before any decision.</h2>
      </div>
      <div class="grid gap-10 sm:grid-cols-3">
        {principles.map((principle) => (
          <div class="reveal">
            <p class="font-mono text-3xl font-bold text-brand-500/40">{principle.number}</p>
            <h3 class="mt-3 text-lg font-semibold">{principle.question}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{principle.answer}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 py-20 dark:border-slate-800">
    <div class="container-page grid gap-10 sm:grid-cols-[200px_1fr] sm:items-center">
      <img
        src={site.avatar}
        alt={site.name}
        class="reveal mx-auto h-40 w-40 rounded-2xl object-cover shadow-lg sm:mx-0"
      />
      <div class="reveal space-y-4">
        <p class="font-mono text-sm text-brand-500">Who's Behind This</p>
        <h2 class="text-2xl font-bold tracking-tight">{site.name}</h2>
        <p class="leading-relaxed text-slate-600 dark:text-slate-300">{bio.longForm[0]}</p>
        <div class="flex flex-wrap gap-4 pt-1">
          <a href="/about" class="text-sm font-semibold text-brand-500 hover:underline">Read my full story →</a>
          <a href="/contact" class="text-sm font-semibold text-brand-500 hover:underline">Let's chat →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="border-t border-slate-200 py-20 dark:border-slate-800">
    <div class="container-page reveal flex flex-col items-center gap-6 text-center">
      <h2 class="text-3xl font-bold tracking-tight">Let's build something worth measuring.</h2>
      <p class="max-w-xl text-slate-600 dark:text-slate-300">
        Whether it's marketing strategy, data analysis, or a project you want built — I'd love to hear about it.
      </p>
      <a href="/contact" class="rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white transition-transform hover:-translate-y-0.5 hover:bg-brand-600">
        Start a conversation
      </a>
    </div>
  </section>
</BaseLayout>
