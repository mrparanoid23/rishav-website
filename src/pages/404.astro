---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="This page doesn't exist." path="/404">
  <section class="container-page flex min-h-[70vh] flex-col items-center justify-center gap-4 text-center">
    <p class="font-mono text-sm text-brand-500">404</p>
    <h1 class="text-4xl font-bold tracking-tight">Page not found</h1>
    <p class="text-slate-600 dark:text-slate-300">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="mt-4 rounded-full bg-brand-500 px-6 py-3 text-sm font-semibold text-white hover:bg-brand-600">
      Back to home
    </a>
  </section>
</BaseLayout>
